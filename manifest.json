{
  "manifest_version": 3,
  "name": "DoomScroll Terminator",
  "version": "1.0",
  "description": "Terminates the doom scrolling in social media wesite",

  "permissions": ["storage", "tabs", "alarms", "notifications"],

  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.reddit.com/*",
    "*://*.twitter.com/*",
    "*://*.instagram.com/*"
  ],

  "icons": {
    "16": "images/avatar16.PNG",
    "32": "images/avatar32.PNG",
    "48": "images/avatar48.PNG",
    "128": "images/avatar128.PNG"
  },

  "background": {
    "service_worker": "scripts/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://www.instagram.com/*",
        "https://x.com/*",
        "https://www.youtube.com/*",
        "https://www.tiktok.com/*",
        "https://www.snapchat.com/*",
        "https://www.reddit.com/*",
        "https://www.tumblr.com/*"
      ],
      "js": ["scripts/content.js"],
      "type": "module"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["images/stage2.png", "images/grass.png", "images/avatar128.png", "images/Boo.gif"],
      "matches": [
        "https://www.facebook.com/*",
        "https://www.instagram.com/*",
        "https://x.com/*",
        "https://www.youtube.com/*",
        "https://www.tiktok.com/*",
        "https://www.snapchat.com/*",
        "https://www.reddit.com/*",
        "https://www.tumblr.com/*"
      ]
    }
  ]
}
